#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_res_company__deca_enabled
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_res_config_settings__deca_enabled
msgid "Enable DeCA"
msgstr "Activar DeCA"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,help:l10n_es_stock_picking_deca.field_res_company__deca_enabled
msgid ""
"Enables the generation of Administrative Control Documents (DeCA) for the "
"outgoing delivery orders of this company."
msgstr ""
"Activa la generación de Documentos de Control Administrativo (DeCA) para "
"los albaranes de salida de esta empresa."

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_res_company__deca_base_url
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_res_config_settings__deca_base_url
msgid "DeCA document base URL"
msgstr "URL base del documento DeCA"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,help:l10n_es_stock_picking_deca.field_res_company__deca_base_url
msgid ""
"Public base URL used to build the DeCA document link. E.g. "
"https://odoo.mycustomer.com"
msgstr ""
"URL base pública utilizada para construir el enlace del documento DeCA. "
"Ej: https://odoo.micliente.com"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_res_company__deca_report_id
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_res_config_settings__deca_report_id
msgid "DeCA report"
msgstr "Informe DeCA"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,help:l10n_es_stock_picking_deca.field_res_company__deca_report_id
msgid "stock.picking report used to generate the DeCA document."
msgstr "Informe de stock.picking utilizado para generar el documento DeCA."

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking__deca_is_generated
msgid "DeCA document generated"
msgstr "Documento DeCA generado"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,help:l10n_es_stock_picking_deca.field_stock_picking__deca_is_generated
msgid "Indicates that this delivery order has a DeCA document generated."
msgstr "Indica que este albarán tiene generado un documento DeCA."

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking__deca_url
msgid "DeCA URL"
msgstr "URL DeCA"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking__deca_attachment_id
msgid "DeCA PDF"
msgstr "PDF DeCA"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking__deca_generation_date
msgid "DeCA generation date"
msgstr "Fecha de generación DeCA"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking__deca_generated_by_id
msgid "Generated by"
msgstr "Generado por"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking__deca_company_enabled
msgid "DeCA enabled on company"
msgstr "DeCA activo en la empresa"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking__deca_qr
msgid "DeCA QR code"
msgstr "Código QR DeCA"

#. module: l10n_es_stock_picking_deca
#: model:ir.model.fields,field_description:l10n_es_stock_picking_deca.field_stock_picking_deca_confirm_wizard__picking_id
msgid "Delivery order"
msgstr "Albarán"

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.view_picking_form_deca
msgid "Generate DeCA document"
msgstr "Generar documento DeCA"

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
#: model:ir.model,name:l10n_es_stock_picking_deca.model_stock_picking_deca_confirm_wizard
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.view_stock_picking_deca_confirm_wizard_form
msgid "Regenerate DeCA document"
msgstr "Regenerar documento DeCA"

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid "The DeCA functionality is not enabled for company %s."
msgstr "La funcionalidad DeCA no está activada para la empresa %s."

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid "The DeCA document can only be generated for outgoing delivery orders."
msgstr ""
"El documento DeCA sólo se puede generar para albaranes de salida."

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid ""
"The delivery order must be in the 'Done' state to generate the DeCA "
"document."
msgstr ""
"El albarán debe estar en estado 'Hecho' para generar el documento DeCA."

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid ""
"The delivery order must be signed before generating the DeCA document. "
"Please sign the delivery order first."
msgstr ""
"El albarán debe estar firmado antes de generar el documento DeCA. Por "
"favor, firme el albarán primero."

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid ""
"No report is configured as the DeCA document in the settings of company "
"%s."
msgstr ""
"No hay ningún informe configurado como documento DeCA en la "
"configuración de la empresa %s."

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid "No base URL is configured for DeCA in the settings of company %s."
msgstr ""
"No hay ninguna URL base configurada para DeCA en la configuración de la "
"empresa %s."

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid "DeCA document regenerated by %(user)s. New URL: %(url)s"
msgstr "Documento DeCA regenerado por %(user)s. Nueva URL: %(url)s"

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/stock_picking.py:0
msgid "DeCA document generated by %(user)s. URL: %(url)s"
msgstr "Documento DeCA generado por %(user)s. URL: %(url)s"

#. module: l10n_es_stock_picking_deca
#: code:addons/l10n_es_stock_picking_deca/models/ir_attachment.py:0
msgid ""
"This attachment cannot be deleted because it is linked as the DeCA "
"document of the following delivery order(s): %s"
msgstr ""
"Este adjunto no se puede eliminar porque está vinculado como documento "
"DeCA de el/los siguiente(s) albarán(es): %s"

#. module: l10n_es_stock_picking_deca
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.view_stock_picking_deca_confirm_wizard_form
msgid ""
"A DeCA document has already been generated for this delivery order. If "
"you continue, the previous PDF will be deleted and a new one will be "
"generated with the corresponding public URL."
msgstr ""
"Ya existe un documento DeCA generado para este albarán. Si continúa, el "
"PDF anterior se eliminará y se generará uno nuevo con la URL pública "
"correspondiente."

#. module: l10n_es_stock_picking_deca
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.view_stock_picking_deca_confirm_wizard_form
msgid "Cancel"
msgstr "Cancelar"

#. module: l10n_es_stock_picking_deca
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.view_picking_form_deca
msgid "DeCA"
msgstr "DeCA"

#. module: l10n_es_stock_picking_deca
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.view_picking_internal_search_deca
msgid "DeCA documents"
msgstr "Documentos DeCA"

#. module: l10n_es_stock_picking_deca
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.res_config_settings_view_form_deca
msgid ""
"Enables the generation of Administrative Control Documents (DeCA) for "
"outgoing delivery orders. Enabling it also requires signature on "
"outgoing delivery orders."
msgstr ""
"Activa la generación de Documentos de Control Administrativo (DeCA) para "
"los albaranes de salida. Al activarlo se exigirá también la firma de los "
"albaranes de salida."

#. module: l10n_es_stock_picking_deca
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.res_config_settings_view_form_deca
msgid ""
"Enabling DeCA also requires signature on outgoing delivery orders (\"Sign "
"on Delivery\" group)."
msgstr ""
"Activar DeCA implica exigir también la firma en los albaranes de salida "
"(grupo \"Firmar en la entrega\")."

#. module: l10n_es_stock_picking_deca
#: model_terms:ir.ui.view,arch_db:l10n_es_stock_picking_deca.report_delivery_document_deca_qr
msgid "DeCA document"
msgstr "Documento DeCA"
