<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_deca_confirm_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.deca.confirm.wizard.form</field>
        <field name="model">stock.picking.deca.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Regenerate DeCA document">
                <field name="picking_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    A DeCA document has already been generated for this
                    delivery order. If you continue, the previous PDF will
                    be deleted and a new one will be generated with the
                    corresponding public URL.
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Regenerate DeCA document"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
