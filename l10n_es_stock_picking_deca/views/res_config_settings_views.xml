<odoo>
    <record id="res_config_settings_view_form_deca" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deca</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="DeCA" name="deca_setting_container">
                    <setting id="deca_enabled_setting"
                             help="Enables the generation of Administrative Control Documents (DeCA) for outgoing delivery orders.">
                        <field name="deca_enabled"/>
                        <div class="content-group" invisible="not deca_enabled">
                            <div class="row mt16">
                                <label for="deca_base_url" class="col-lg-4 o_light_label"/>
                                <field name="deca_base_url"
                                       required="deca_enabled"
                                       placeholder="https://odoo.mycustomer.com"/>
                            </div>
                            <div class="row mt8">
                                <label for="deca_report_id" class="col-lg-4 o_light_label"/>
                                <field name="deca_report_id"
                                       required="deca_enabled"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                    <setting
                        id="deca_enabled_setting_sign"
                        help="Makes required signing before DeCA document generation. This will enable sign option for pickings."
                        invisible="not deca_enabled"
                    >
                        <field name="deca_sign_required" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
