<odoo>
    <record id="res_config_settings_view_form_deca" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deca</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='stock']" position="inside">
                <h2>DeCA</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="deca_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="deca_enabled"/>
                            <div class="text-muted">
                                Enabling DeCA also requires signature on outgoing
                                delivery orders ("Sign on Delivery" group).
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="deca_base_url"/>
                            <div class="text-muted"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="deca_base_url"
                                        placeholder="https://odoo.mycustomer.com"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="deca_report_id"/>
                            <div class="text-muted"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="deca_report_id"
                                        options="{'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
