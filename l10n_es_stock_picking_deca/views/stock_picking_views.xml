<odoo>
    <record id="action_generate_deca" model="ir.actions.server">
        <field name="name">(Re)generate DeCA</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            res = records.action_generate_deca()
            if isinstance(res, dict):
                action = res
        </field>
    </record>

    <record id="view_picking_form_deca" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.deca</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <field name="deca_company_enabled" invisible="1"/>
                <field name="deca_is_generated" invisible="1"/>
                <button name="action_generate_deca" type="object"
                        string="Generate DeCA document"
                        class="btn-primary"
                        invisible="not deca_company_enabled or picking_type_code != 'outgoing' or state != 'done' or deca_is_generated"/>
                <button name="action_generate_deca" type="object"
                        string="Regenerate DeCA document"
                        confirm="DeCA document is already generated. Do you generate it again? Former document will be replaced"
                        invisible="not deca_company_enabled or picking_type_code != 'outgoing' or state != 'done' or not deca_is_generated"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="DeCA" name="deca_page" invisible="not deca_is_generated">
                    <group>
                        <group>
                            <field name="deca_is_generated" invisible="1"/>
                            <field
                                name="deca_hash_string"
                                readonly="1"
                                groups="base.group_no_one"
                                string="Hash String"
                            />
                            <field
                                name="deca_hash"
                                readonly="1"
                                groups="base.group_no_one"
                                string="Hash"
                            />
                            <field
                                name="deca_url"
                                widget="url"
                                readonly="1"
                                string="URL"
                            />
                            <field
                                name="deca_attachment_id"
                                readonly="1"
                                string="Attachment"
                            />
                        </group>
                        <group>
                            <field
                                name="deca_generation_date"
                                readonly="1"
                                string="Generation Date"
                            />
                            <field
                                name="deca_generated_by_id"
                                readonly="1"
                                string="Generated By"
                            />
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_picking_internal_search_deca" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.deca</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_deca_documents"
                        string="DeCA documents"
                        domain="[('deca_is_generated', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
