<odoo>
    <!--
        Adds a QR code in the header of the standard delivery slip report
        ("stock.report_delivery_document"), visible only when:
          - the picking is a DeCA document (o.deca_is_generated), and
          - this same report is the one configured at company level as the
            DeCA reference report (company.deca_report_id).

        NOTE: the xpath targets the first child of "div.page", which is the
        standard structure of "stock.report_delivery_document" in Odoo 17.
        If the standard report has been customized in the target instance,
        the xpath may need to be adjusted.
    -->
    <template id="report_delivery_document_deca_qr" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]/*[1]" position="before">
            <div class="row mb-4"
                 t-if="o.deca_company_enabled and o.deca_is_generated">
                <div class="col-3 offset-9 text-center">
                    <img
                        t-attf-src="data:image/png;base64,{{o.deca_qr}}"
                        style="width:120px;height:120px;"
                        alt="DeCA QR"/>
                    <div><small>DeCA document</small></div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
